# Database (Postgres). Set DATABASE_URL OR the individual DB_* vars.
DATABASE_URL=postgres://user:password@host:5432/case_tracker
DB_HOST=localhost
DB_PORT=5432
DB_NAME=case_tracker
DB_USER=postgres
DB_PASSWORD=replace_me
# Set to false to disable SSL requirement (e.g. local Postgres for tests)
DB_SSL=true

# Backend tests (requires an isolated database; DB_SSL=false recommended)
TEST_DATABASE_URL=postgres://user:password@localhost:5432/case_tracker_test
TEAR_DOWN=1

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Server
PORT=5000
FRONTEND_URL=http://localhost:3000

# Supabase storage (documents, receipts)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# SMTP (emails are skipped when SMTP_PASS is empty)
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=support@example.com
SMTP_PASS=
SMTP_FROM="نظام إدارة القضايا <support@example.com>"

# Client portal base URL
PORTAL_URL=http://localhost:3000/#/portal

# Financials migration is OPT-IN; set to 'true' to apply on server start
APPLY_FINANCIAL_MIGRATIONS=false
